# Copy this file to .env, then set the values for your local environment.
NATS_CREDENTIALS_PATH=/absolute/path/to/s3.consumer.creds
S3_BACKUP_BUCKET=your-backup-bucket

# Optional: omit these to use the default AWS credential provider chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=
