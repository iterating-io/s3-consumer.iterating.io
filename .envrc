# Spring Boot 실행 프로필. 로컬 실행은 local, 운영 환경은 prod를 사용한다.
export SPRING_PROFILES_ACTIVE="${SPRING_PROFILES_ACTIVE:-local}"

# NATS 서버 주소. 여러 서버를 사용할 때는 쉼표로 구분한다.
export NATS_SERVERS="${NATS_SERVERS:-nats://localhost:4222}"

# NATS 연결 식별자. 서버의 연결 목록과 로그에서 이 프로세스를 구분할 때 사용한다.
export NATS_CONNECTION_NAME="${NATS_CONNECTION_NAME:-s3-reconcile-local}"

# JetStream 메시지를 읽을 스트림 이름.
export NATS_STREAM="${NATS_STREAM:-S3_INBOX}"

# JetStream durable consumer 이름. 재시작 후에도 소비 위치를 유지한다.
export NATS_DURABLE="${NATS_DURABLE:-s3-reconcile}"

# 이 consumer가 구독할 NATS subject.
export NATS_FILTER_SUBJECT="${NATS_FILTER_SUBJECT:-s3.objects.reconcile}"

# 한 번의 pull 요청에서 가져올 최대 메시지 수. 1 이상의 정수여야 한다.
export NATS_BATCH_SIZE="${NATS_BATCH_SIZE:-10}"

# NATS pull 요청의 최대 대기 시간. Spring Duration 형식(예: 5s, 500ms)을 사용한다.
export NATS_FETCH_TIMEOUT="${NATS_FETCH_TIMEOUT:-5s}"

# 처리할 메시지가 없을 때 다음 pull 전까지 기다리는 시간. Spring Duration 형식을 사용한다.
export NATS_IDLE_DELAY="${NATS_IDLE_DELAY:-5s}"

# NATS 사용자 자격증명 파일 경로 또는 인라인 credentials 내용.
# 실제 *.creds 파일은 Git에 커밋하지 않는다.
export NATS_CREDENTIALS_PATH="${NATS_CREDENTIALS_PATH:-$PWD/nats.creds}"

# 원본 객체를 이동하기 전에 복사해 둘 백업 버킷 이름. 실행 전에 반드시 설정한다.
export S3_BACKUP_BUCKET="${S3_BACKUP_BUCKET:-}"

# AWS 또는 S3 호환 서비스의 리전.
export AWS_REGION="${AWS_REGION:-us-east-1}"

# S3 호환 서비스 endpoint. AWS S3 기본 endpoint를 사용할 때도 현재 run.sh 계약상 값을 설정해야 한다.
export AWS_ENDPOINT_URL="${AWS_ENDPOINT_URL:-}"

# 정적 AWS access key. 비워 두면 애플리케이션은 AWS 기본 credentials provider chain을 사용한다.
# 실제 키를 이 파일에 직접 기록하거나 Git에 커밋하지 않는다.
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-}"

# 정적 AWS secret key. AWS_ACCESS_KEY_ID와 함께 사용하며 실제 값은 외부에서 주입한다.
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-}"

# 참고: AWS_SESSION_TOKEN은 현재 애플리케이션 설정에 연결되어 있지 않으므로 여기서 export하지 않는다.
